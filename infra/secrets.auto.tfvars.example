# scripts/env-to-tfvars.sh で .env から secrets.auto.tfvars を生成する。
# 手で作る場合は、このファイルを secrets.auto.tfvars にコピーして値を入れる（コミットしないこと）。
# 書かなかった項目は Terraform が生成したランダムな値を使う。

# Azure SQL の管理者パスワード（8〜128 文字。英大文字・英小文字・数字・記号のうち 3 種類以上。; は使わない）
sql_admin_password = "<パスワード>"

# JWT の署名鍵（32 文字以上のランダムな文字列）
jwt_signing_key = "<署名鍵>"
